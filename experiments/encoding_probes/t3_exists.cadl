sos:
  name: "Exists"
  type: Collaborative
  version: "1.0.0"
  actors:
    - id: "TAXI[1..N]"
      role: "taxi"
      autonomy: high
    - id: CENTER
      role: "center"
      autonomy: low
    - id: DEPOT
      role: "depot"
      autonomy: low
  contracts:
    - id: RULE_C
      parties: [CENTER, "TAXI[*]"]
      assume:
        - "exists t in TAXI[*]: TAXI[t].speed > 50"
      guarantee:
        - "service_level >= 1"
    - id: DEST_D
      parties: ["TAXI[*]"]
      guarantee:
        - "exists t in TAXI[*]: TAXI[t].speed < 10"
